# ==============================================================================
# Plod-Ploi (ปลดปล่อย) Environment Variables Example
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or real secret keys to Git!
# ==============================================================================

# 1. Supabase Configuration (Public / Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_STORAGE_BUCKET=toilet-photos

# 2. Supabase Server / Admin Configuration (SERVER-ONLY - Never expose to client!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 3. LINE Official Account & Messaging API (SERVER-ONLY for Webhook)
LINE_CHANNEL_SECRET=your_line_messaging_api_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_messaging_api_channel_access_token
SEARCH_LOG_HMAC_SECRET=your_random_hmac_secret_for_search_logs
APP_BASE_URL=https://your-app-domain.vercel.app

# 4. LINE LIFF & LINE Login Configuration
# - NEXT_PUBLIC_LIFF_ID: Used by client LIFF SDK (`liff.init`)
# - LINE_LOGIN_CHANNEL_ID: Used by server (`/api/liff/action`) to verify LIFF ID Tokens with LINE OAuth2 API
NEXT_PUBLIC_LIFF_ID=your_liff_id
LIFF_ID=your_liff_id
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

# 5. Map Tile Server (Leaflet + OpenStreetMap — Configurable without code changes)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
